{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitHub Documentation Manager",
  "version": "1.0.0",
  "identifier": "com.damienbutler.ghdocmanager",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "GitHub Documentation Manager",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0d1117",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Quick lookup for GitHub documentation",
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {}
}
